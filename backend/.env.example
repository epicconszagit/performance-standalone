# Leave DATABASE_URL unset to use a local SQLite file (zero setup, good for testing).
# Point it at Clever Cloud (or any) MySQL when you're ready:
# DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=604800

# Leave SMTP_USERNAME/SMTP_PASSWORD unset to log emails to the console instead
# of sending them. Fill in to send real email - defaults to Gmail's SMTP
# server. For Gmail, SMTP_PASSWORD must be an App Password (16 characters,
# generated at https://myaccount.google.com/apppasswords), not your real
# Google password - that requires 2-Step Verification to be enabled first.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Leave all unset to log SMS messages to the console instead of sending
# them (same fallback pattern as email). Fill in to send real SMS via Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
